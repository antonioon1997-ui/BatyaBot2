# Telegram
BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_ID=replace_with_your_telegram_id

# Bot settings
TIMEZONE=Europe/Moscow
REMINDER_TIME=08:50
DATABASE_PATH=bot.db

# Linux systemd service names
BOT_SERVICE_NAME=batyabot2.service
UPDATER_SERVICE_NAME=batyabot2-updater.service

# Google Sheets order status integration
# Use an absolute path to the service-account JSON file.
# Do not add the real JSON credentials file to Git.
GOOGLE_SHEETS_CREDENTIALS=/absolute/path/to/google-service-account.json
ORDER_STATUS_SPREADSHEET_ID=replace_with_spreadsheet_id
ORDER_STATUS_SHEET_NAME=NEW_API_Заказы
ORDER_STATUS_CACHE_TTL_SECONDS=60
ORDER_STATUS_REQUEST_TIMEOUT_SECONDS=20
